; audio_stub.def — common def file for all four stub audio DLLs
;
; Each alias maps the undecorated name (what GetProcAddress searches for)
; to the __stdcall-decorated symbol in the object file.
;
; LIBRARY name is overridden per-build via the /out: linker switch.

EXPORTS
    Audio_GetVersion = _Audio_GetVersion@0
    InitAudioSystem = _InitAudioSystem@8
    Audio_Shutdown = _Audio_Shutdown@0
    Audio_Restore = _Audio_Restore@0
    AudioStop = _AudioStop@0
    AudioSetCameraPos = _AudioSetCameraPos@20
    SetAmbient = _SetAmbient@12
    SetAmbient3d = _SetAmbient3d@20
    AddVoice3dv = _AddVoice3dv@24
    Audio_SetEnvironment = _Audio_SetEnvironment@8
    Audio_UploadGeometry = _Audio_UploadGeometry@8
